#!ipxe
# NVMe/TCP + DH-HMAC-CHAP validation script (embedded into test firmware)
#
# Credential flow:
#   DHCP -> HTTP /boot-vars?mac=${mac}&hostname=..  (control plane endpoint)
#        -> returned body is executed as iPXE script: set nbft-secret ...
#        -> sanboot nvme://...?secret=${nbft-secret}
#
# The secret never lives in the firmware: it is delivered by the
# control plane per client and injected at boot time.
#
# slirp network: guest 10.0.2.15, host loopback reachable at 10.0.2.2

dhcp || echo DHCP-FAIL

echo === CRED-FETCH begin ===
chain --autofree http://10.0.2.2:8000/boot-vars?mac=${mac}&hostname=ipxe-auth-test && echo CRED-FETCH-OK || goto cred-failed
echo "nbft-secret = ${nbft-secret}"
echo "uuid = ${uuid}"
echo === CRED-FETCH end ===

echo === NVME-TCP-AUTH-TEST: sanboot begin ===
sanboot nvme://10.0.2.2:4420/nqn.2026-08.org.ipxe-stateless:test?secret=${nbft-secret}
echo === NVME-TCP-AUTH-TEST: sanboot rc = ${?} ===
echo === NVME-TCP-AUTH-TEST: sanboot failed, no GRUB handover ===
shell

:cred-failed
echo
echo *** Credential fetch failed: dropping to iPXE shell ***
echo
shell
