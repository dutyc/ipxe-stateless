#!ipxe
# NVS backend setup phase: store device-key and server-fingerprint
# into the EFI variable (explicit nvo block), then display them.
set nvo/device-key 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
set nvo/server-fingerprint aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899
show nvo/device-key
show nvo/server-fingerprint
echo NVS-SETUP-DONE
exit
