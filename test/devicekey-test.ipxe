#!ipxe
# Device key command self-test (R5): keygen -> pubkey -> sign
# Round 1 (clean NVRAM): keygen generates, pubkey prints hex point,
#   sign prints base64 DER signature over the fixed test string.
# Round 2 (kept NVRAM): keygen must refuse to overwrite; pubkey/sign
#   must still work, proving NVRAM persistence.
echo === DEVICEKEY-TEST-BEGIN ===
keygen || echo "keygen: refused (expected on round 2)"
pubkey
sign 0123456789abcdef52:54:00:12:34:56host123
echo === DEVICEKEY-TEST-DONE ===
exit
